{
  "generator": {
    "templates_dir": "templates",
    "train_data": {
      "dataset_size": 15000,
      "rotation_range": 10,
      "placement_offset_x": 8,
      "placement_offset_y": 8,
      "img_size": 256,
      "save_dir": "datasets/generated",
      "crop_save_dir": "datasets/train",
      "seed": 42
    },
    "val_data": {
      "dataset_size": 3000,
      "rotation_range": 10,
      "placement_offset_x": 8,
      "placement_offset_y": 8,
      "img_size": 256,
      "save_dir": "datasets/generated",
      "crop_save_dir": "datasets/val",
      "seed": 123
    }
  },
  "model": {
    "img_height": 256,
    "img_width": 256,
    "img_channels": 3,
    "n_classes": 1,
    "normalize_coords": true,
    "subtract_mean": 127.5,
    "divide_by_stddev": 127.5,
    "l2_regularization": 0.5,
    "predictor_sizes": [[8, 8]]
  },
  "training": {
    "batch_size": 16,
    "epochs": 500,
    "val_split": 0.2,
    "random_seed": 42,
    "optimizer": {
      "learning_rate": 0.0001,
      "beta_1": 0.9,
      "beta_2": 0.999,
      "epsilon": 1e-8
    },
    "loss": {
      "neg_pos_ratio": 3,
      "alpha": 3.0
    },
    "early_stopping": {
      "monitor": "val_loss",
      "min_delta": 0.0,
      "patience": 7,
      "verbose": 1,
      "restore_best_weights": true
    },
    "lr_schedule": {
      "monitor": "val_loss",
      "factor": 0.2,
      "patience": 4,
      "verbose": 1,
      "min_delta": 0.001,
      "cooldown": 0,
      "min_lr": 1e-7
    },
    "performance": {
      "jit_compile": false,
      "mixed_float16": false
    }
  },
  "augmentation": {
    "enabled": true,
    "probability": 0.1
  }
}
